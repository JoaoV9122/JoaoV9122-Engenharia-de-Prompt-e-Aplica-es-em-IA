            "=== Calculadora Simples ===\n",
            "Operações disponíveis: +, -, *, /\n",
            "Digite o primeiro número: 20\n",
            "Digite o operador (+, -, *, /): -\n",
            "Digite o segundo número: 20\n",
            "Resultado: 0.0\n"
          ]
