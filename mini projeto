      ],
      "source": [
        "def _perform_calculation(num1, operador, num2):\n",
        "    \"\"\"Performs the arithmetic calculation based on the operator.\"\"\"\n",
        "    if operador == \"+\":\n",
        "        return num1 + num2\n",
        "    elif operador == \"-\":\n",
        "        return num1 - num2\n",
        "    elif operador == \"*\":\n",
        "        return num1 * num2\n",
        "    elif operador == \"/\":\n",
        "        if num2 == 0:\n",
        "            raise ZeroDivisionError(\"Erro: divisão por zero não é permitida.\")\n",
        "        return num1 / num2\n",
        "    else:\n",
        "        raise ValueError(\"Operador inválido.\")\n",
        "\n",
        "def calculadora():\n",
        "    print(\"=== Calculadora Simples ===\")\n",
        "    print(\"Operações disponíveis: +, -, *, /\")\n",
        "\n",
        "    try:\n",
        "        num1 = float(input(\"Digite o primeiro número: \"))\n",
        "        operador = input(\"Digite o operador (+, -, *, /): \")\n",
        "        num2 = float(input(\"Digite o segundo número: \"))\n",
        "\n",
        "        resultado = _perform_calculation(num1, operador, num2)\n",
        "        print(f\"Resultado: {resultado}\")\n",
        "\n",
        "    except ValueError:\n",
        "        print(\"Erro: entrada inválida ou operador inválido. Digite apenas números e operadores válidos.\")\n",
        "    except ZeroDivisionError as e:\n",
        "        print(e)\n",
        "    except Exception as e:\n",
        "        # Catch any other unexpected errors\n",
        "        print(f\"Ocorreu um erro inesperado: {e}\")\n",
        "\n",
        "calculadora()"
      ]
    }
